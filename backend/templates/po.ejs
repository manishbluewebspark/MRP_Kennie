<% const fmtDate=(d)=> {
  if (!d) return "-";
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return "-";
  const dd = String(dt.getDate()).padStart(2, "0");
  const mm = String(dt.getMonth() + 1).padStart(2, "0");
  const yyyy = dt.getFullYear();
  return `${dd}/${mm}/${yyyy}`;
  };

  const money = (n) => {
  const x = Number(n || 0);
  return x.toFixed(2);
  };

  const poNo = po?.poNumber || "-";
  const currency = po?.currency || "SGD";
  const supplier = po?.supplier || {};
  const shipTo = po?.shipToAddress || "";
  const terms = po?.termsConditions || "";
  const items = Array.isArray(po?.items) ? po.items : [];
  const totals = po?.totals || {};
  const taxPercentage =
  Number(po?.taxPercentage)
  %>

  <!doctype html>
  <html>

  <head>
    <meta charset="utf-8" />
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        color: #111;

      }

      .page {
        min-height: 99vh;

        display: flex;
        flex-direction: column;

      }

      .content {
        padding: 10px;
        border: 1px solid black;
        flex: 1;
      }

      .terms {
        margin-top: 24px;
        border: 1px solid #999;
        padding: 10px;

        page-break-inside: avoid;
        break-inside: avoid;
      }


      .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }

      .company h1 {
        margin: 0;
        font-size: 18px;
        letter-spacing: .2px;
      }

      .company p {
        margin: 3px 0;
        font-size: 11px;
        color: #333;
        line-height: 1.35;
      }

      .po-title {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
      }

      .po-title h2 {
        margin: 0;
        font-size: 22px;
        letter-spacing: .3px;
      }

      .po-no {
        font-size: 22px;
        font-weight: 700;
      }

      .info-row {
        background: #e5e5e5;
        margin-top: 14px;
        border: 1px solid #999;
        display: flex;
      }

      .info-cell {
        flex: 1;
        padding: 8px 10px;
        font-size: 11px;
        border-right: 1px solid #999;
      }

      .info-cell:last-child {
        border-right: none;
      }

      .info-cell b {
        font-weight: 700;
      }

      .two-col {
        margin-top: 14px;
        display: flex;
        gap: 14px;
      }

      .box {
        flex: 1;
        border: 1px solid #999;
        padding: 3px;
        min-height: 92px;
      }

      .box-title {
        font-size: 11px;
        border: 1px solid #999;
        background: #e5e5e5;
        font-weight: 700;
        padding-top: 5px;
        padding-bottom: 5px;
        margin-bottom: 6px;
      }

      .box p {
        margin: 2px 0;
        font-size: 11px;
        color: #222;
        line-height: 1.35;
      }

      .section-title {
        margin-top: 18px;
        font-size: 12px;
        font-weight: 700;
      }

      .delivery {
        margin-top: 6px;
        border: 1px solid #999;
      }

      .delivery .row {
        display: flex;
      }

      .delivery .cell {
        flex: 1;
        padding: 8px 10px;
        font-size: 11px;
        border-right: 1px solid #ddd;
        border-bottom: 1px solid #ddd;
      }

      .delivery .cell:last-child {
        border-right: none;
      }

      .delivery .row:last-child .cell {
        border-bottom: none;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
      }

      thead th {
        background: #e5e5e5;
        font-size: 11px;
        color: #000;
        border: 1px solid #999;
      }

      tbody td {
        border: 1px solid #999;
        font-size: 11px;
        padding: 8px;
        vertical-align: top;
      }

      .num {
        text-align: right;
        white-space: nowrap;
      }

      .center {
        text-align: center;
      }

      .totals {
        margin-top: 10px;
        display: flex;
        justify-content: flex-end;
      }

      .totals-box {
        width: 280px;
      }

      .totals-line {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 11px;
      }

      .grand {
        font-size: 14px;
        font-weight: 800;
        padding-top: 8px;
        border-top: 1px solid #ddd;
      }



      .terms h3 {
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 6px;
      }

      .terms pre {
        white-space: pre-wrap;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        margin: 0;
        color: #222;
        line-height: 1.35;
      }

      .header-right {
        display: flex;
        width: 50%;
        font-size: 10px;
        line-height: 1;
      }

      .header-right .right-col {
        width: 50%;
      }

      .address-block {
        text-align: left;
      }

      .contact-block {
        text-align: right;
      }

      .header-right p {
        margin: 0;
      }

      .website {
        color: red;
        font-weight: 600;
      }

      .header-left p {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        color: #000;
      }
    </style>
  </head>

  <body>
    <div class="page">
      <div class="content">
        <div class="header">
          <!-- LEFT : LOGO -->
          <div class="header-left">
            <p>EXXEL TECHNOLOGY PTE LTD</p>
          </div>

          <!-- RIGHT : DETAILS -->
          <div class="header-right">
            <!-- RIGHT LEFT PART : ADDRESS -->
            <div class="right-col address-block">
              <p>1 Kaki Bukit Ave 3</p>
              <p>KB-1 #03-07</p>
              <p>Singapore 416087</p>
            </div>

            <!-- RIGHT RIGHT PART : CONTACT -->
            <div class="right-col contact-block">
              <p>Tel : (65) 6743-4553</p>
              <p>Fax : (65) 6743-6929</p>
              <p>Email : sales@exxeltech.com</p>
              <!-- <p class="website">exxeltech.com</p> -->
              <p>UEN/GST No: 199407327W</p>
            </div>
          </div>

        </div>



        <div class="po-title">
          <h2>PURCHASE ORDER</h2>
          <div class="po-no">PO No: <%= poNo %>
          </div>
        </div>

        <div class="info-row">
          <div class="info-cell"><b>Date:</b>
            <%= fmtDate(po?.poDate) %>
          </div>
          <div class="info-cell"><b>Currency:</b>
            <%= supplier?.currency?.code %>
          </div>
          <div class="info-cell"><b>Buyer:</b> Procurement Dept</div>

        </div>

        <div class="two-col">
          <div class="box">
            <div class="box-title">Order To:</div>
            <p>
                <pre style="margin:0"><%= supplier?.companyName || supplier?.name || "-" %></pre>
              </p>
            <p>
              <pre style="margin:0"><%= supplier?.companyAddress || "" %></pre>
            </p>
            
           
            <p><pre style="margin:0"><%= supplier?.email || "-" %></pre>
            </p>
            <p> <pre style="margin:0"><%= supplier?.phone || "-" %></pre>
            </p>
             <p><pre style="margin:0">Attn: <%= supplier?.contactPerson || supplier?.name || "-" %></pre>
            </p>
            
          </div>

          <div class="box">
            <div class="box-title">Ship To:</div>
            <p>
            <pre style="margin:0"><%= shipTo %></pre>
            </p>
            <!-- <p>Attn: <%= po?.shipToAttn || "Kennie Seow" %> -->
            </p>
          </div>
        </div>

        <div class="section-title">Delivery &amp; Payment</div>
        <div class="delivery">
          <div class="row">
            <div class="cell"><b>Need Date:</b>
              <%= fmtDate(po?.needDate) %>
            </div>
            <div class="cell"><b>ETA Date:</b>
              <%= fmtDate(po?.etaDate) %>
            </div>
          </div>
          <div class="row">
            <div class="cell"><b>Incoterms:</b>
              <%= po?.supplier?.incoTerms || "-" %>
            </div>
            <div class="cell"><b>Payment Terms:</b>
              <%= po?.supplier?.paymentTerms || "-" %>
            </div>
          </div>
        </div>

        <div class="section-title">Order Details</div>

        <table>
          <thead>
            <tr>
              <th style="width:50px" class="start">No.</th>
              <th style="width:120px">Part Number</th>
              <th>Description</th>
              <th>Manufacturer</th>
              <th style="width:60px" class="center">Qty</th>
              <th style="width:60px" class="center">UOM</th>
              <th style="width:90px" class="num">Unit Price</th>
              <!-- <th style="width:90px" class="num">Dis Price</th> -->
              <th style="width:90px" class="num">Ext. Price</th>
            </tr>
          </thead>

          <tbody>
            <% if(items.length===0) { %>
              <tr>
                <td colspan="8">No items</td>
              </tr>
              <% } %>

                <% items.forEach((it, idx)=> { %>
                  <tr>
                    <td class="center">
                      <%= idx + 1 %>
                    </td>
                    <td>
                      <%= it?.mpnText || it?.partNumber || it?.mpn?.MPN || "-" %>
                    </td>
                    <td>
                      <%= it?.description || "-" %>
                    </td>
                    <td>
                      <%= it?.manufacturer || "-" %>
                    </td>
                    <td class="center">
                      <%= it?.qty ?? 0 %>
                    </td>
                    <td class="center">
                      <%= it?.uomText || it?.uom?.code || "-" %>
                    </td>
                    <td class="num"><%= money(it?.unitPrice) %>
                    </td>
                    <!-- <td class="num">
                      <%= Number(it?.discount || 0).toFixed(2) %>
                    </td> -->
                    <td class="num">
                      <%= Number(it?.extPrice || 0).toFixed(2) %>
                    </td>
                    </td>
                  </tr>
                  <% }) %>
          </tbody>
        </table>








        <div class="totals">
          <div class="totals-box" style="border:1px solid #999;padding:10px">
             <div class="totals-line"><span>Gross Amount:</span> <span>
                <%= money(totals?.subTotalAmount + totals?.totalDiscount) %>
              </span></div>
              <div class="totals-line"><span>Discount:</span> <span>
                -<%= money(totals?.totalDiscount) %>
              </span></div>
                <div class="totals-line"><span>Sub-Total:</span> <span>
                <%= money(totals?.subTotalAmount) %>
              </span></div>
            <div class="totals-line"><span>Freight Cost:</span> <span>
                <%= money(totals?.freightAmount) %>
              </span></div>
            
          
            <div class="totals-line"><span>
                <%= taxPercentage %>% GST Tax:
              </span> <span>
                <%= money(totals?.ostTax) %>
              </span></div>
            <div class="totals-line grand"><span>Grand Total:</span> <span>
                <%= money(totals?.finalAmount) %>
              </span>
            </div>
          </div>
        </div>

      </div>


      <% if (terms) { %>
        <div class="terms">
          <h3>Terms and Conditions:</h3>
          <pre><%= terms %></pre>
        </div>
        <% } %>
    </div>


  </body>

  </html>